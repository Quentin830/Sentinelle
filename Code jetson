def gen():
    global frame_stream
    dernier_envoi = time.time()
    while True:
        if frame_stream is None:
            time.sleep(0.05)
            continue
        maintenant = time.time()
        if maintenant - dernier_envoi < 0.08:
            time.sleep(0.01)
            continue
        dernier_envoi = maintenant
        frame_mini = cv2.resize(frame_stream, (320, 180))
        ret, jpeg = cv2.imencode('.jpg', frame_mini, [int(cv2.IMWRITE_JPEG_QUALITY), 40])
        if not ret: continue
        yield (b'--frame\r\nContent-Type: image/jpeg\r\n\r\n' + jpeg.tobytes() + b'\r\n')


@app.route('/video_feed')
def video_feed():
    return Response(gen(), mimetype='multipart/x-mixed-replace; boundary=frame')


