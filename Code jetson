# ==========================================
# 0. LE FILTRE DE FUSION DE CAPTEURS (GPS + IMU)
# ==========================================
class RobotPosition:
    def __init__(self):
        self.lat = 0.0
        self.lon = 0.0
        self.last_time = time.time()
        self.m_to_lat = 1.0 / 111111.0
        self.premier_fix = False

    def update(self, gps_lat, gps_lon, acc_x, acc_y):
        current_time = time.time()
        dt = current_time - self.last_time
        self.last_time = current_time
        ALPHA = 0.95

        # Si le GPS est à 0 (pas de signal), on ne fait rien pour l'instant
        if gps_lat == 0.0 and not self.premier_fix:
            return 0.0, 0.0

        if gps_lat != 0.0 and not self.premier_fix:
            self.lat = gps_lat
            self.lon = gps_lon
            self.premier_fix = True

        dist_x = 0.5 * acc_x * (dt ** 2)
        pred_lat = self.lat + (dist_x * self.m_to_lat)

        if gps_lat != 0.0:
            self.lat = (ALPHA * gps_lat) + ((1 - ALPHA) * pred_lat)
            self.lon = gps_lon
        else:
            self.lat = pred_lat

        return self.lat, self.lon


filtre_position = RobotPosition()

