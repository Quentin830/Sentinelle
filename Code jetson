# ==========================================
# 2. LES CERVEAUX ARRIÈRE-PLAN (ONNX & SERIAL)
# ==========================================
def analyse_environnement_arriere_plan(session, input_name):
    global proba_eau_globale, frame_pour_eau, analyse_active
    while analyse_active:
        if frame_pour_eau is not None:
            try:
                frame_resized = cv2.resize(frame_pour_eau, (224, 224))
                blob_eau = cv2.dnn.blobFromImage(frame_resized, 1 / 255.0, (224, 224), mean=(0.485, 0.456, 0.406),
                                                 swapRB=True, crop=False)
                predictions = session.run(None, {input_name: blob_eau})[0]
                proba_eau_globale = predictions[0][1]
            except Exception as e:
                pass
        time.sleep(0.1)


def ecouter_arduino(port_serie):
    """Ce thread écoute l'Arduino, lit le GPS/IMU et passe les données dans ton filtre !"""
    global etat_robot, analyse_active, filtre_position
    while analyse_active:
        if port_serie and port_serie.in_waiting > 0:
            try:
                ligne = port_serie.readline().decode('utf-8').strip()
                donnees = ligne.split(',')

                # Si on reçoit bien les 5 valeurs de l'Arduino
                if len(donnees) >= 5:
                    g_lat = float(donnees[0])
                    g_lon = float(donnees[1])
                    cap = int(donnees[2])
                    ax = float(donnees[3])
                    ay = float(donnees[4])

                    # On passe le GPS brut dans le filtre avec l'IMU
                    lat_filtree, lon_filtree = filtre_position.update(g_lat, g_lon, ax, ay)

                    # On met à jour le tableau de bord avec les données lisses
                    etat_robot['latitude'] = lat_filtree
                    etat_robot['longitude'] = lon_filtree
                    etat_robot['cap'] = cap

            except Exception as e:
                pass
        time.sleep(0.05)


# ==========================================
# 3. LE PROGRAMME PRINCIPAL
# ==========================================
try:
    arduino = serial.Serial('/dev/ttyUSB0', 115200, timeout=0.1)
    time.sleep(2)
except:
    arduino = None


def suivre_humain():
    global frame_pour_eau, frame_stream, analyse_active, proba_eau_globale, etat_robot

    gstreamer_pipeline = (
        "nvarguscamerasrc ! "
        "video/x-raw(memory:NVMM), width=1280, height=720, format=(string)NV12, framerate=(fraction)30/1 ! "
        "nvvidconv flip-method=0 ! "
        "video/x-raw, width=480, height=270, format=(string)BGRx ! "
        "videoconvert ! "
        "video/x-raw, format=(string)BGR ! appsink drop=true max-buffers=1"
    )
    cap = cv2.VideoCapture(gstreamer_pipeline, cv2.CAP_GSTREAMER)

    net = cv2.dnn.readNetFromDarknet('yolov3-tiny.cfg', 'yolov3-tiny.weights')
    output_layers = net.getUnconnectedOutLayersNames()

    session_eau = ort.InferenceSession('water_classifier.onnx')
    input_name_eau = session_eau.get_inputs()[0].name

    threading.Thread(target=analyse_environnement_arriere_plan, args=(session_eau, input_name_eau), daemon=True).start()
    threading.Thread(target=lancer_serveur, daemon=True).start()
    if arduino:
        threading.Thread(target=ecouter_arduino, args=(arduino,), daemon=True).start()

    compteur_images = 0
    memoire_box = None
    memoire_perte = 0
    dernier_dir = 1500
    dernier_acc = 1500
    humain_detecte = False

    temps_precedent = time.time()
    erreur_precedente_x = 0
    integrale_x = 0
    erreur_precedente_z = 0
    integrale_z = 0

    try:
        while True:
            ret, frame = cap.read()
            if not ret: break

            (h, w) = frame.shape[:2]
            compteur_images += 1
            frame_pour_eau = frame

            mode_pwm = 2000 if proba_eau_globale > 0.6 else 1000
            etat_robot["mode_terrain"] = "EAU" if proba_eau_globale > 0.6 else "TERRE"

            if compteur_images % 2 == 0:
                humain_detecte = False
                blob = cv2.dnn.blobFromImage(frame, 0.00392, (320, 320), (0, 0, 0), True, crop=False)
                net.setInput(blob)
                outs = net.forward(output_layers)

                plus_gros_humain_surface = 0

                for out in outs:
                    for detection in out:
                        scores = detection[5:]
                        class_id = np.argmax(scores)
                        confidence = scores[class_id]

                        if confidence > 0.2 and class_id == 0:
                            center_x = int(detection[0] * w)
                            center_y = int(detection[1] * h)
                            width_box = int(detection[2] * w)
                            height_box = int(detection[3] * h)

                            startX = int(center_x - width_box / 2)
                            startY = int(center_y - height_box / 2)
                            endX = startX + width_box
                            endY = startY + height_box
                            surface = width_box * height_box

                            if surface > plus_gros_humain_surface:
                                plus_gros_humain_surface = surface
                                memoire_box = (startX, startY, endX, endY)
                                humain_detecte = True

            if humain_detecte and memoire_box is not None:
                memoire_perte = 0
                (startX, startY, endX, endY) = memoire_box
                centre_humain_x = (startX + endX) // 2
                largeur_humain = endX - startX
                centre_image = w // 2

                temps_actuel = time.time()
                dt = max(temps_actuel - temps_precedent, 0.001)
                temps_precedent = temps_actuel

                erreur_x = centre_humain_x - centre_image
                integrale_x += erreur_x * dt
                derivee_x = (erreur_x - erreur_precedente_x) / dt
                erreur_precedente_x = erreur_x

                correction_x = (1.2 * erreur_x) + (0.0 * integrale_x) + (0.15 * derivee_x)
                dir_pwm = int(1500 + correction_x)
                dir_pwm = max(1100, min(1900, dir_pwm))

                taille_cible = w * 0.40
                erreur_z = taille_cible - largeur_humain

                integrale_z += erreur_z * dt
                derivee_z = (erreur_z - erreur_precedente_z) / dt
                erreur_precedente_z = erreur_z

                correction_z = (1.0 * erreur_z) + (0.0 * integrale_z) + (0.2 * derivee_z)
                acc_pwm = int(1500 + correction_z)
                acc_pwm = max(1350, min(1650, acc_pwm))

                if 1470 < acc_pwm < 1530:
                    acc_pwm = 1500

                etat_robot["statut_ia"] = "SUIVI AUTO"

                dernier_dir = dir_pwm
                dernier_acc = acc_pwm

                cv2.rectangle(frame, (startX, startY), (endX, endY), (0, 255, 0), 2)
                cv2.drawMarker(frame, (centre_humain_x, (startY + endY) // 2), (0, 255, 0), cv2.MARKER_CROSS, 20, 2)

            else:
                memoire_perte += 1
                if memoire_perte < 15:
                    dir_pwm = dernier_dir
                    acc_pwm = dernier_acc
                    etat_robot["statut_ia"] = "RECHERCHE..."
                    temps_precedent = time.time()
                else:
                    dir_pwm = 1500
                    acc_pwm = 1500
                    etat_robot["statut_ia"] = "ATTENTE CIBLE"
                    erreur_precedente_x = 0
                    erreur_precedente_z = 0
                    integrale_x = 0
                    integrale_z = 0

            etat_robot["direction"] = dir_pwm
            etat_robot["vitesse"] = acc_pwm

            # Envoi des commandes Moteurs à l'Arduino
            if arduino and (compteur_images % 2 == 0):
                commande = f"{dir_pwm},{acc_pwm},{mode_pwm}\n"
                arduino.write(commande.encode('utf-8'))

            frame_stream = frame.copy()

    finally:
        analyse_active = False
        cap.release()
        cv2.destroyAllWindows()


if __name__ == '__main__':
    suivre_humain()
